# CCTK_REAL2 (binary16) leg of the AMReX plotfile output test: state2 is
# widened to double for the plotfile (interim I1) rather than being silently
# skipped from the varlist.
#
# This is par/testreal4_plotfile.par of the sibling thorn TestReal4 (which
# carries this suite's REAL8/REAL4 layer) with TestReal2 activated
# alongside it, so the run checks all three precisions -- exactly what the
# single combined thorn did before the REAL2 split (CCTK_REAL2 is an
# optional flesh type, so REAL2-incapable platforms build TestReal4 only).
# TestReal2 shares TestReal4's run_*_test parameters, so the switches below
# steer both thorns. Keep the two parfiles in sync.

ActiveThorns = "
    CarpetX
    IOUtil
    TestReal4
    TestReal2
"

Cactus::cctk_show_schedule = "no"
Cactus::presync_mode = "mixed-error"

Cactus::cctk_itlast = 1

CarpetX::verbose = "no"
CarpetX::poison_undefined_values = "yes"

# Domain extent is 2 in each direction, an integer multiple of the
# analytic function's period of 1, so that the ghost zones' periodic
# images are reproduced exactly by the domain's periodic boundaries.
CarpetX::xmin = -1.0
CarpetX::ymin = -1.0
CarpetX::zmin = -1.0
CarpetX::xmax = +1.0
CarpetX::ymax = +1.0
CarpetX::zmax = +1.0

CarpetX::ncells_x = 32
CarpetX::ncells_y = 32
CarpetX::ncells_z = 32

# Unigrid: a single refinement level only.
CarpetX::max_num_levels = 1

CarpetX::ghost_size_x = 3
CarpetX::ghost_size_y = 3
CarpetX::ghost_size_z = 3

Driver::periodic = "yes"
Driver::periodic_x = "yes"
Driver::periodic_y = "yes"
Driver::periodic_z = "yes"

CarpetX::reflection_x = "no"
CarpetX::reflection_y = "no"
CarpetX::reflection_z = "no"

CarpetX::reflection_upper_x = "no"
CarpetX::reflection_upper_y = "no"
CarpetX::reflection_upper_z = "no"

# --- File output: AMReX plotfile only -----------------------------------

IO::out_dir = $parfile
IO::out_every = 1
IO::parfile_write = no

CarpetX::out_metadata = no

# Both precision groups (interim I1: state4 is widened to double for the
# plotfile, rather than being skipped).
CarpetX::out_plotfile_groups = "
    TestReal4::state8
    TestReal4::state4
    TestReal2::state2
"

# This parfile activates TestReal4's original periodic self-test only.
TestReal4::run_periodic_test = "yes"
# TestReal2_Check hard-verifies this exact parfile-steered CCTK_REAL2 value
TestReal2::check_tolerance2 = 0.0078125
TestReal4::run_2lev_test = "no"
TestReal4::run_bc_test = "no"
TestReal4::run_evol_test = "no"
