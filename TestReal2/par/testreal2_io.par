# CCTK_REAL2 (binary16) leg of the I/O services + checkpointing test: REAL2
# groups are widened to float32 on viz-format (openPMD/Silo/TSV) output, but
# round-trip bit-exactly through the openPMD checkpoint (D6), for grid
# functions and grid scalars/arrays alike.
#
# This is par/testreal2_io.par of the sibling thorn TestReal4 (which
# carries this suite's REAL8/REAL4 layer) with TestReal2 activated
# alongside it, so the run checks all three precisions -- exactly what the
# single combined thorn did before the REAL2 split (CCTK_REAL2 is an
# optional flesh type, so REAL2-incapable platforms build TestReal4 only).
# TestReal2 shares TestReal4's run_*_test parameters, so the switches below
# steer both thorns. Keep the two parfiles in sync.

ActiveThorns = "
    CarpetX
    IOUtil
    TestReal4
    TestReal2
"

Cactus::cctk_show_schedule = "no"
Cactus::presync_mode = "mixed-error"

Cactus::cctk_itlast = 1
Cactus::terminate = "iteration"

CarpetX::verbose = "no"
CarpetX::poison_undefined_values = "yes"

# Domain extent is 2 in each direction, an integer multiple of the
# analytic function's period of 1, so that the ghost zones' periodic
# images are reproduced exactly by the domain's periodic boundaries.
CarpetX::xmin = -1.0
CarpetX::ymin = -1.0
CarpetX::zmin = -1.0
CarpetX::xmax = +1.0
CarpetX::ymax = +1.0
CarpetX::zmax = +1.0

CarpetX::ncells_x = 32
CarpetX::ncells_y = 32
CarpetX::ncells_z = 32

# Unigrid: a single refinement level only.
CarpetX::max_num_levels = 1

CarpetX::ghost_size_x = 3
CarpetX::ghost_size_y = 3
CarpetX::ghost_size_z = 3

Driver::periodic = "yes"
Driver::periodic_x = "yes"
Driver::periodic_y = "yes"
Driver::periodic_z = "yes"

CarpetX::reflection_x = "no"
CarpetX::reflection_y = "no"
CarpetX::reflection_z = "no"

CarpetX::reflection_upper_x = "no"
CarpetX::reflection_upper_y = "no"
CarpetX::reflection_upper_z = "no"

# --- File output -------------------------------------------------------

IO::out_dir = $parfile
IO::out_every = 1
IO::out_fileinfo = "axis labels"
IO::parfile_write = no

CarpetX::out_metadata = no

# Norms: all three test-state groups, so their norms can be compared for
# agreement (see par/testreal4_io_recover.par and the verification notes
# alongside this parfile).
CarpetX::out_norm_vars = "
    TestReal4::state8
    TestReal4::state4
    TestReal2::state2
"
CarpetX::out_norm_omit_unstable = yes
CarpetX::out_norm_omit_sumloc_for_backward_compatibility = yes

# openPMD: this build's openPMD_api was built with the ADIOS2 backend only
# (no HDF5 backend), so use ADIOS2_BP5 explicitly (rather than leaving it
# at the default ADIOS2_auto, so the on-disk format is pinned) -- the
# written .bp5 files can be inspected with ADIOS2's `bpls -l` to confirm
# the REAL4 grid function is actually stored as a 32-bit float variable.
#
# The scalar8/scalar4 and array8/array4 grid scalar/grid array groups
# (Phase 4, src/testreal4_scalar_array.cxx) are included alongside the grid
# function groups above, so this same viz-format output (and, below, the
# checkpoint) also exercises CarpetX's grid scalar/grid array I/O path at
# both precisions, not just its grid function path.
CarpetX::openpmd_format = "ADIOS2_BP5"
CarpetX::out_openpmd_vars = "
    TestReal4::state8
    TestReal4::state4
    TestReal2::state2
    TestReal4::scalar8
    TestReal4::scalar4
    TestReal2::scalar2
    TestReal4::array8
    TestReal4::array4
    TestReal2::array2
"

# Silo: both test-state groups, plus the grid scalar/grid array groups.
CarpetX::out_silo_vars = "
    TestReal4::state8
    TestReal4::state4
    TestReal2::state2
    TestReal4::scalar8
    TestReal4::scalar4
    TestReal2::scalar2
    TestReal4::array8
    TestReal4::array4
    TestReal2::array2
"

# TSV: all three test-state groups, plus the grid scalar/grid array groups.
CarpetX::out_tsv = yes
CarpetX::out_tsv_vars = "
    TestReal4::state8
    TestReal4::state4
    TestReal2::state2
    TestReal4::scalar8
    TestReal4::scalar4
    TestReal2::scalar2
    TestReal4::array8
    TestReal4::array4
    TestReal2::array2
"

# --- Checkpointing -------------------------------------------------------
#
# Checkpoint (via openPMD, so the same code path as the file output above)
# once, at iteration 1, then terminate; par/testreal4_io_recover.par picks
# up from that checkpoint. Parameter spellings copied from
# TestOutput/test/checkpoint-openpmd.par.

CarpetX::checkpoint_method = "openpmd"
IO::checkpoint_dir = $parfile + "/checkpoints"
IO::checkpoint_ID = no
IO::checkpoint_every = 1
IO::checkpoint_on_terminate = yes

# This parfile activates TestReal4's original periodic self-test only.
TestReal4::run_periodic_test = "yes"
# TestReal2_Check hard-verifies this exact parfile-steered CCTK_REAL2 value
TestReal2::check_tolerance2 = 0.0078125
TestReal4::run_2lev_test = "no"
TestReal4::run_bc_test = "no"
TestReal4::run_evol_test = "no"
