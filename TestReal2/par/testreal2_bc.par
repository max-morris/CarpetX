# CCTK_REAL2 (binary16) leg of the physical (dirichlet) boundary condition
# test, exercising CarpetX's BoundaryCondition<CCTK_REAL2> code path.
#
# This is par/testreal4_bc.par of the sibling thorn TestReal4 (which
# carries this suite's REAL8/REAL4 layer) with TestReal2 activated
# alongside it, so the run checks all three precisions -- exactly what the
# single combined thorn did before the REAL2 split (CCTK_REAL2 is an
# optional flesh type, so REAL2-incapable platforms build TestReal4 only).
# TestReal2 shares TestReal4's run_*_test parameters, so the switches below
# steer both thorns. Keep the two parfiles in sync.

ActiveThorns = "
    CarpetX
    IOUtil
    TestReal4
    TestReal2
"

Cactus::cctk_show_schedule = "no"
Cactus::presync_mode = "mixed-error"

Cactus::cctk_itlast = 1

CarpetX::verbose = "no"
CarpetX::poison_undefined_values = "yes"

CarpetX::xmin = -1.0
CarpetX::ymin = -1.0
CarpetX::zmin = -1.0
CarpetX::xmax = +1.0
CarpetX::ymax = +1.0
CarpetX::zmax = +1.0

CarpetX::ncells_x = 16
CarpetX::ncells_y = 16
CarpetX::ncells_z = 16

# Unigrid: a single refinement level only.
CarpetX::max_num_levels = 1

CarpetX::ghost_size = 2

# Non-periodic, dirichlet on every face (Driver::periodic defaults to "no").
CarpetX::boundary_x = "dirichlet"
CarpetX::boundary_y = "dirichlet"
CarpetX::boundary_z = "dirichlet"
CarpetX::boundary_upper_x = "dirichlet"
CarpetX::boundary_upper_y = "dirichlet"
CarpetX::boundary_upper_z = "dirichlet"

# This parfile activates TestReal4's boundary-condition test only.
TestReal4::run_periodic_test = "no"
TestReal4::run_2lev_test = "no"
TestReal4::run_bc_test = "yes"
TestReal4::run_evol_test = "no"

# No file output.
