# CCTK_REAL2 (binary16) leg of the checkpoint/recovery test: the recovery
# companion of par/testreal2_io.par, verifying that REAL2 grid functions and
# grid scalars/arrays come back *bit-exactly* (their raw 16-bit payload, per
# D6, rather than the widened float32 used for viz-format output).
#
# This is par/testreal4_io_recover.par of the sibling thorn TestReal4 (which
# carries this suite's REAL8/REAL4 layer) with TestReal2 activated
# alongside it, so the run checks all three precisions -- exactly what the
# single combined thorn did before the REAL2 split (CCTK_REAL2 is an
# optional flesh type, so REAL2-incapable platforms build TestReal4 only).
# TestReal2 shares TestReal4's run_*_test parameters, so the switches below
# steer both thorns. Keep the two parfiles in sync.
#
# NOTE: IO::recover_dir below is a path relative to this run's own working
# directory (.../mp/testreal2-io-recover/output-0000/, per how `cactup sim
# run` lays out simulation directories) back to the checkpoint directory
# written by par/testreal2_io.par. It therefore only resolves correctly
# when the two parfiles are run as `cactup sim` simulations literally
# named "testreal2-io" (for this parfile's companion) and
# "testreal2-io-recover" (for this parfile itself) -- mirroring, for our
# sim-run-based invocation, the same recover_dir role that
# TestOutput/test/recover-openpmd.par's (test-suite-relative) IO::recover_dir
# plays for that thorn's checkpoint-openpmd.par/recover-openpmd.par pair.

ActiveThorns = "
    CarpetX
    IOUtil
    TestReal4
    TestReal2
"

Cactus::cctk_show_schedule = "no"
Cactus::presync_mode = "mixed-error"

Cactus::cctk_itlast = 2

CarpetX::verbose = "no"
CarpetX::poison_undefined_values = "yes"

CarpetX::xmin = -1.0
CarpetX::ymin = -1.0
CarpetX::zmin = -1.0
CarpetX::xmax = +1.0
CarpetX::ymax = +1.0
CarpetX::zmax = +1.0

CarpetX::ncells_x = 32
CarpetX::ncells_y = 32
CarpetX::ncells_z = 32

CarpetX::max_num_levels = 1

CarpetX::ghost_size_x = 3
CarpetX::ghost_size_y = 3
CarpetX::ghost_size_z = 3

Driver::periodic = "yes"
Driver::periodic_x = "yes"
Driver::periodic_y = "yes"
Driver::periodic_z = "yes"

CarpetX::reflection_x = "no"
CarpetX::reflection_y = "no"
CarpetX::reflection_z = "no"

CarpetX::reflection_upper_x = "no"
CarpetX::reflection_upper_y = "no"
CarpetX::reflection_upper_z = "no"

IO::out_dir = $parfile
IO::out_every = 1
IO::out_fileinfo = "axis labels"
IO::parfile_write = no

CarpetX::out_metadata = no

CarpetX::out_norm_vars = "
    TestReal4::state8
    TestReal4::state4
    TestReal2::state2
"
CarpetX::out_norm_omit_unstable = yes
CarpetX::out_norm_omit_sumloc_for_backward_compatibility = yes

CarpetX::openpmd_format = "ADIOS2_BP5"
CarpetX::out_openpmd_vars = "
    TestReal4::state8
    TestReal4::state4
    TestReal2::state2
    TestReal4::scalar8
    TestReal4::scalar4
    TestReal2::scalar2
    TestReal4::array8
    TestReal4::array4
    TestReal2::array2
"

CarpetX::out_silo_vars = "
    TestReal4::state8
    TestReal4::state4
    TestReal2::state2
    TestReal4::scalar8
    TestReal4::scalar4
    TestReal2::scalar2
    TestReal4::array8
    TestReal4::array4
    TestReal2::array2
"

CarpetX::out_tsv = yes
CarpetX::out_tsv_vars = "
    TestReal4::state8
    TestReal4::state4
    TestReal2::state2
    TestReal4::scalar8
    TestReal4::scalar4
    TestReal2::scalar2
    TestReal4::array8
    TestReal4::array4
    TestReal2::array2
"

# --- Recovery -------------------------------------------------------------
#
# Recover from the checkpoint written by par/testreal2_io.par (see the
# path-scoping NOTE above), then keep checkpointing so a further
# checkpoint/recovery round trip stays possible.

CarpetX::recover_method = "openpmd"
IO::recover_dir = "../../testreal2-io/output-0000/testreal2_io/checkpoints"
IO::recover = "autoprobe"

CarpetX::checkpoint_method = "openpmd"
IO::checkpoint_dir = $parfile + "/checkpoints"
IO::checkpoint_ID = no
IO::checkpoint_every = 1
IO::checkpoint_on_terminate = yes

TestReal4::run_periodic_test = "yes"
# TestReal2_Check hard-verifies this exact parfile-steered CCTK_REAL2 value
TestReal2::check_tolerance2 = 0.0078125
TestReal4::run_2lev_test = "no"
TestReal4::run_bc_test = "no"
TestReal4::run_evol_test = "no"
