# CCTK_REAL2 (binary16) leg of the ODESolvers RK4 evolution smoke test,
# exercising ODESolvers::statecomp_t with a binary16 (state, rhs) pair.
#
# This is par/testreal4_evol.par of the sibling thorn TestReal4 (which
# carries this suite's REAL8/REAL4 layer) with TestReal2 activated
# alongside it, so the run checks all three precisions -- exactly what the
# single combined thorn did before the REAL2 split (CCTK_REAL2 is an
# optional flesh type, so REAL2-incapable platforms build TestReal4 only).
# TestReal2 shares TestReal4's run_*_test parameters, so the switches below
# steer both thorns. Keep the two parfiles in sync.

ActiveThorns = "
    CarpetX
    IOUtil
    ODESolvers
    TestReal4
    TestReal2
"

Cactus::cctk_show_schedule = "no"
Cactus::presync_mode = "mixed-error"

CarpetX::verbose = "no"
CarpetX::poison_undefined_values = "yes"

CarpetX::ncells_x = 1
CarpetX::ncells_y = 1
CarpetX::ncells_z = 1

CarpetX::blocking_factor_x = 1
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 1

CarpetX::ghost_size = 0

Driver::periodic = "yes"
Driver::periodic_x = "yes"
Driver::periodic_y = "yes"
Driver::periodic_z = "yes"

CarpetX::dtfac = 0.001
Cactus::cctk_itlast = 50

ODESolvers::method = "RK4"

TestReal4::evol_decay_rate = 1.0
TestReal4::evol_u0 = 1.0

# This parfile activates TestReal4's evolution smoke test only.
TestReal4::run_periodic_test = "no"
TestReal4::run_2lev_test = "no"
TestReal4::run_bc_test = "no"
TestReal4::run_evol_test = "yes"

# No file output.
