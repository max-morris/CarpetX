# Interface definition for thorn TestReal2
#
# The CCTK_REAL2 (binary16) layer of the mixed-precision test suite whose
# CCTK_REAL8/CCTK_REAL4 layer lives in the sibling thorn TestReal4. Every
# group below is the REAL2 counterpart of a state8_*/state4_* pair there,
# declared on the same centering, with the same TAGS, and initialized and
# checked by the same analytic functions -- see TestReal4's interface.ccl
# for the per-test rationale (which centering exercises what, why the
# dirichlet tags matter, and so on), which applies here unchanged.
#
# The split exists because CCTK_REAL2 is an optional flesh type: configure
# defines HAVE_CCTK_REAL2 only where the C compiler provides _Float16
# (GCC >= 12 on x86-64; nvcc-compiled translation units use __half
# instead), and a thorn declaring CCTK_REAL2 grid variables or parameters
# cannot be built at all without it. Keeping the REAL2 layer in its own
# thorn lets REAL2-incapable platforms drop this one thorn from their
# thornlist and still run the full REAL8/REAL4 test suite; see
# src/testreal2_requires_real2.hxx.
#
# TestReal2 rides on TestReal4's parameters (param.ccl SHARES them), so
# both thorns' checks are steered by the same run_*_test switches and the
# same evolution parameters, and a parfile that activates both runs the
# suite at all three precisions -- exactly as the single combined thorn
# did before the split.

IMPLEMENTS: TestReal2

USES INCLUDE HEADER: loop.hxx
USES INCLUDE HEADER: loop_device.hxx

PRIVATE:

CCTK_REAL2 state2 TYPE=gf
{
  u2
} "REAL2 (binary16) mixed-precision test state"



# --- Phase 2: two-level (regrid + prolongation) test -----------------------

CCTK_REAL2 state2_2lev TYPE=gf TAGS='dirichlet_values={0.0}'
{
  u2_2lev
} "REAL2 linear test state for the two-level regrid+prolongation test"



# --- Phase 2: edge-centered restriction test (interim I2) -------------------
#
# Interim: local FAB-templated edge average-down. Upstream goal: template
# amrex::average_down_edges over FAB (mirroring average_down_faces); drop
# this kernel when the ET's AMReX includes that.

CCTK_REAL2 state2_edgex TYPE=gf CENTERING={cvv} TAGS='dirichlet_values={0.0}'
{
  u2_edgex
} "REAL2 linear test state, edge-centered along x, for the restriction test"

CCTK_REAL2 state2_edgey TYPE=gf CENTERING={vcv} TAGS='dirichlet_values={0.0}'
{
  u2_edgey
} "REAL2 linear test state, edge-centered along y, for the restriction test"

CCTK_REAL2 state2_edgez TYPE=gf CENTERING={vvc} TAGS='dirichlet_values={0.0}'
{
  u2_edgez
} "REAL2 linear test state, edge-centered along z, for the restriction test"



# --- Phase 2: face-centered restriction test --------------------------------
#
# CCTK_REAL2 face-centered restriction goes through the local, __half-clean
# average_down_faces_local kernel (CarpetX's restrict_edges.hxx), because
# upstream AMReX's own FAB-templated point kernel for faces
# (amrex_avgdown_faces) computes a `T(1.0) / int` expression that is not
# __half-clean as of AMReX 25.11. TestReal4's REAL8/REAL4 face groups go
# through the stock, unmodified amrex::average_down_faces instead, so
# running both thorns together covers both paths.

CCTK_REAL2 state2_facex TYPE=gf CENTERING={vcc} TAGS='dirichlet_values={0.0}'
{
  u2_facex
} "REAL2 linear test state, face-centered normal to x, for the restriction test"

CCTK_REAL2 state2_facey TYPE=gf CENTERING={cvc} TAGS='dirichlet_values={0.0}'
{
  u2_facey
} "REAL2 linear test state, face-centered normal to y, for the restriction test"

CCTK_REAL2 state2_facez TYPE=gf CENTERING={ccv} TAGS='dirichlet_values={0.0}'
{
  u2_facez
} "REAL2 linear test state, face-centered normal to z, for the restriction test"



# --- Phase 2: physical boundary condition test ------------------------------
#
# The dirichlet_values tag value below must match the constant hardcoded in
# src/testreal2_bc.cxx.

CCTK_REAL2 state2_bc TYPE=gf CENTERING={CCC} TAGS='dirichlet_values={3.5}'
{
  u2_bc
} "REAL2 test state for verifying dirichlet physical boundary conditions"



# --- Phase 2: ODESolvers evolution smoke test -------------------------------

CCTK_REAL2 state2_evol TYPE=gf CENTERING={CCC} TAGS='rhs="TestReal2::rhs2_evol"'
{
  u2_evol
} "REAL2 exponential-decay ODE state (du/dt = -decay_rate u)"

CCTK_REAL2 rhs2_evol TYPE=gf CENTERING={CCC} TAGS='checkpoint="no"'
{
  r2_evol
} "RHS of state2_evol"



# =============================================================================
# Phase 4: grid scalar / grid array sized-real coverage
# =============================================================================
#
# The REAL2 counterparts of TestReal4's scalar8/scalar4 and array8/array4,
# exercising CarpetX's AnyTypeVector-backed grid scalar/array storage
# (driver.hxx) at binary16: allocation, poisoning, validity checking,
# checkpoint/recovery, and I/O output. Every value written by
# src/testreal2_scalar_array.cxx is an exact binary fraction, so it is
# representable bit-for-bit in binary16 and can be re-verified bit-exactly.

CCTK_REAL2 scalar2 TYPE=scalar "REAL2 grid scalar test value"

CCTK_REAL2 array2 TYPE=array DIM=1 SIZE=16 DISTRIB=constant "REAL2 grid array test values"



# =============================================================================
# Phase 5: aliased-FUNCTION sized-REAL argument/return-type coverage
# =============================================================================
#
# The REAL2-carrying half of the aliased-function coverage: a CCTK_REAL4
# return type together with mixed CCTK_REAL8, CCTK_REAL4, and CCTK_REAL2
# argument types on one aliased function, which is what exercises the
# grammar/binding-generation gap this workflow closes (flesh's
# src/piraha/pegs/interface.peg ret_type/arg_type rules, and
# CreateFunctionBindings.pl's ParseArgument allow-list). TestReal4 keeps a
# REAL2-free alias of the same shape (CCTK_REAL8/CCTK_REAL4 args), so the
# sized-REAL signature machinery stays covered on platforms without REAL2.
#
# TestReal2 both PROVIDES and USES this function (like Formaline's
# UniqueConfigID and friends), so no other thorn needs to be touched:
# src/testreal2_mixargs.cxx implements the provider, and
# src/testreal2_mixargs_check.cxx (a different translation unit) calls the
# alias and verifies the result. Note that flesh guards *generated
# aliased-function bindings* behind HAVE_CCTK_REAL2, so on a REAL2-less
# configuration this function would simply never be registered -- but this
# thorn's own sources could not be compiled there in any case, which is why
# it is a separate thorn.
#
# C/C++ only: CCTK_REAL2 has no Fortran spelling (cctk_Types.h), so this
# function must never be called from Fortran.

CCTK_REAL4 FUNCTION TestReal2_MixArgs \
    (CCTK_REAL8 IN a, CCTK_REAL4 IN b, CCTK_REAL2 IN c)

PROVIDES FUNCTION TestReal2_MixArgs \
    WITH TestReal2_MixArgs_Impl \
    LANGUAGE C
USES FUNCTION TestReal2_MixArgs
