# Phase 4 self-checking mixed-precision test: checkpoint/recovery leg for
# par/testreal4_io.par. Recovers the state that parfile checkpointed (via
# openPMD) at iteration 1, then continues the same single-level periodic
# self-test (TestReal4_Check, gated by run_periodic_test) for one more
# iteration -- verifying that the REAL8 (u8), REAL4 (u4), and REAL2 (u2)
# test states all continue to satisfy the analytic solution after a
# checkpoint/recovery round trip, i.e. that CarpetX's (now
# precision-generic) checkpoint/recovery code path preserves REAL4 data
# correctly, and preserves REAL2 data *bit-exactly* (its raw 16-bit
# payload, per D6, rather than the widened float32 used for viz-format
# output below).
#
# NOTE: IO::recover_dir below is a path relative to this run's own working
# directory (.../mp/testreal4-io-recover/output-0000/, per how `cactup sim
# run` lays out simulation directories) back to the checkpoint directory
# written by par/testreal4_io.par. It therefore only resolves correctly
# when the two parfiles are run as `cactup sim` simulations literally
# named "testreal4-io" (for this parfile's companion) and
# "testreal4-io-recover" (for this parfile itself) -- mirroring, for our
# sim-run-based invocation, the same recover_dir role that
# TestOutput/test/recover-openpmd.par's (test-suite-relative) IO::recover_dir
# plays for that thorn's checkpoint-openpmd.par/recover-openpmd.par pair.

ActiveThorns = "
    CarpetX
    IOUtil
    TestReal4
"

Cactus::cctk_show_schedule = "no"
Cactus::presync_mode = "mixed-error"

Cactus::cctk_itlast = 2

CarpetX::verbose = "no"
CarpetX::poison_undefined_values = "yes"

CarpetX::xmin = -1.0
CarpetX::ymin = -1.0
CarpetX::zmin = -1.0
CarpetX::xmax = +1.0
CarpetX::ymax = +1.0
CarpetX::zmax = +1.0

CarpetX::ncells_x = 32
CarpetX::ncells_y = 32
CarpetX::ncells_z = 32

CarpetX::max_num_levels = 1

CarpetX::ghost_size_x = 3
CarpetX::ghost_size_y = 3
CarpetX::ghost_size_z = 3

Driver::periodic = "yes"
Driver::periodic_x = "yes"
Driver::periodic_y = "yes"
Driver::periodic_z = "yes"

CarpetX::reflection_x = "no"
CarpetX::reflection_y = "no"
CarpetX::reflection_z = "no"

CarpetX::reflection_upper_x = "no"
CarpetX::reflection_upper_y = "no"
CarpetX::reflection_upper_z = "no"

IO::out_dir = $parfile
IO::out_every = 1
IO::out_fileinfo = "axis labels"
IO::parfile_write = no

CarpetX::out_metadata = no

CarpetX::out_norm_vars = "
    TestReal4::state8
    TestReal4::state4
    TestReal4::state2
"
CarpetX::out_norm_omit_unstable = yes
CarpetX::out_norm_omit_sumloc_for_backward_compatibility = yes

CarpetX::openpmd_format = "ADIOS2_BP5"
CarpetX::out_openpmd_vars = "
    TestReal4::state8
    TestReal4::state4
    TestReal4::state2
"

CarpetX::out_silo_vars = "
    TestReal4::state8
    TestReal4::state4
    TestReal4::state2
"

CarpetX::out_tsv = yes
CarpetX::out_tsv_vars = "
    TestReal4::state8
    TestReal4::state4
    TestReal4::state2
"

# --- Recovery -------------------------------------------------------------
#
# Recover from the checkpoint written by par/testreal4_io.par (see the
# path-scoping NOTE above), then keep checkpointing so a further
# checkpoint/recovery round trip stays possible.

CarpetX::recover_method = "openpmd"
IO::recover_dir = "../../testreal4-io/output-0000/testreal4_io/checkpoints"
IO::recover = "autoprobe"

CarpetX::checkpoint_method = "openpmd"
IO::checkpoint_dir = $parfile + "/checkpoints"
IO::checkpoint_ID = no
IO::checkpoint_every = 1
IO::checkpoint_on_terminate = yes

TestReal4::run_periodic_test = "yes"
TestReal4::run_2lev_test = "no"
TestReal4::run_bc_test = "no"
TestReal4::run_evol_test = "no"
