# Phase 2 self-checking mixed-precision test: static mesh refinement
# (BoxInBox) creates a second refinement level around the origin; a REAL8,
# a REAL4, and a REAL2 grid function, all holding a linear function of the
# coordinates, are initialized on the coarse level and then verified on
# ALL levels (interior and ghost zones, excluding the outer physical
# boundary) against the analytic function. Because the function is linear
# and CarpetX::prolongation_order = 1, double/float/half prolongation onto
# (and across) the fine level must be exact up to roundoff.

ActiveThorns = "
    BoxInBox
    CarpetX
    CarpetXRegrid
    IOUtil
    TestReal4
"

Cactus::cctk_show_schedule = "no"
Cactus::presync_mode = "mixed-error"

Cactus::cctk_itlast = 2

CarpetX::verbose = "no"
CarpetX::poison_undefined_values = "yes"

CarpetX::xmin = -1.0
CarpetX::ymin = -1.0
CarpetX::zmin = -1.0
CarpetX::xmax = +1.0
CarpetX::ymax = +1.0
CarpetX::zmax = +1.0

CarpetX::ncells_x = 24
CarpetX::ncells_y = 24
CarpetX::ncells_z = 24

CarpetX::blocking_factor_x = 4
CarpetX::blocking_factor_y = 4
CarpetX::blocking_factor_z = 4

CarpetX::ghost_size = 2

CarpetX::prolongation_type = "natural"
CarpetX::prolongation_order = 1

# Non-periodic outer boundary (dirichlet, with an arbitrary constant --
# TestReal4_2Lev_Check excludes the outer boundary from its check, since
# that is covered separately by testreal4_bc.par).
CarpetX::boundary_x = "dirichlet"
CarpetX::boundary_y = "dirichlet"
CarpetX::boundary_z = "dirichlet"
CarpetX::boundary_upper_x = "dirichlet"
CarpetX::boundary_upper_y = "dirichlet"
CarpetX::boundary_upper_z = "dirichlet"

# Static mesh refinement: one cubical region around the origin, refined by
# one additional level, well inside the domain (so the refinement boundary
# never touches the outer physical boundary).
CarpetX::max_num_levels = 2
CarpetX::regrid_every = 1

BoxInBox::num_regions = 1
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = 2
BoxInBox::position_x_1 = 0.0
BoxInBox::position_y_1 = 0.0
BoxInBox::position_z_1 = 0.0
BoxInBox::radius_1[1] = 0.4

# This parfile activates TestReal4's two-level test only.
TestReal4::run_periodic_test = "no"
TestReal4::run_2lev_test = "yes"
TestReal4::run_bc_test = "no"
TestReal4::run_evol_test = "no"

# No file output.
