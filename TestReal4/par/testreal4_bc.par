# Phase 2 self-checking mixed-precision test: physical (dirichlet) boundary
# conditions. A REAL8 and a REAL4 cell-centred grid function are each
# initialized to a value different from their (per-group) dirichlet
# constant, then synced -- which applies CarpetX's physical boundary
# conditions -- and finally checked: every point in the outer-boundary
# region must carry exactly the configured dirichlet value, for both
# precisions. This exercises the templated BoundaryCondition<CCTK_REAL4>
# code path (boundaries.cxx/boundaries_impl.hxx) alongside the existing
# double-precision path.

ActiveThorns = "
    CarpetX
    IOUtil
    TestReal4
"

Cactus::cctk_show_schedule = "no"
Cactus::presync_mode = "mixed-error"

Cactus::cctk_itlast = 1

CarpetX::verbose = "no"
CarpetX::poison_undefined_values = "yes"

CarpetX::xmin = -1.0
CarpetX::ymin = -1.0
CarpetX::zmin = -1.0
CarpetX::xmax = +1.0
CarpetX::ymax = +1.0
CarpetX::zmax = +1.0

CarpetX::ncells_x = 16
CarpetX::ncells_y = 16
CarpetX::ncells_z = 16

# Unigrid: a single refinement level only.
CarpetX::max_num_levels = 1

CarpetX::ghost_size = 2

# Non-periodic, dirichlet on every face (Driver::periodic defaults to "no").
CarpetX::boundary_x = "dirichlet"
CarpetX::boundary_y = "dirichlet"
CarpetX::boundary_z = "dirichlet"
CarpetX::boundary_upper_x = "dirichlet"
CarpetX::boundary_upper_y = "dirichlet"
CarpetX::boundary_upper_z = "dirichlet"

# This parfile activates TestReal4's boundary-condition test only.
TestReal4::run_periodic_test = "no"
TestReal4::run_2lev_test = "no"
TestReal4::run_bc_test = "yes"
TestReal4::run_evol_test = "no"

# No file output.
