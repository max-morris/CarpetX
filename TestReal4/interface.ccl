# Interface definition for thorn TestReal4
#
# Self-checking mixed-precision test: a CCTK_REAL8 and a CCTK_REAL4 grid
# function, both on the same (default) centering. Both are filled with a
# deterministic, periodic analytic function of the coordinates, synced, and
# then verified everywhere (interior and ghost zones) to make sure
# single-level ghost exchange works correctly for CCTK_REAL4 grid functions
# alongside a CCTK_REAL8 one.
#
# The CCTK_REAL2 (binary16) layer of this same suite lives in the sibling
# thorn TestReal2, which declares the state2_*/scalar2/array2 counterparts
# of everything below and is steered by this thorn's parameters (it SHARES
# them). Activating both thorns runs the suite at all three precisions.
# The split keeps TestReal4 buildable everywhere: CCTK_REAL2 is an optional
# flesh type (HAVE_CCTK_REAL2, which configure defines only where the C
# compiler provides _Float16 -- GCC >= 12 on x86-64), and a thorn declaring
# CCTK_REAL2 grid variables or parameters cannot be built without it, so
# REAL2-incapable platforms simply drop TestReal2 from their thornlist and
# still get the whole REAL8/REAL4 suite from here.

IMPLEMENTS: TestReal4

USES INCLUDE HEADER: loop.hxx
USES INCLUDE HEADER: loop_device.hxx

PRIVATE:

CCTK_REAL8 state8 TYPE=gf
{
  u8
} "REAL8 (double) mixed-precision test state"

CCTK_REAL4 state4 TYPE=gf
{
  u4
} "REAL4 (float) mixed-precision test state"



# --- Phase 2: two-level (regrid + prolongation) test -----------------------
#
# Vertex-centred (default centering, matching state8/state4 above) so that
# CarpetX::prolongation_type = "interpolate" or "natural" with
# CarpetX::prolongation_order = 1 reproduces a linear function of the
# coordinates exactly (up to floating-point roundoff), for both precisions.
# The dirichlet_values tag is only exercised when the owning parfile also
# sets CarpetX::boundary_x etc. to "dirichlet"; par/testreal4_2lev.par
# excludes points near the outer physical boundary from the check, so the
# actual constant is not significant.

CCTK_REAL8 state8_2lev TYPE=gf TAGS='dirichlet_values={0.0}'
{
  u8_2lev
} "REAL8 linear test state for the two-level regrid+prolongation test"

CCTK_REAL4 state4_2lev TYPE=gf TAGS='dirichlet_values={0.0}'
{
  u4_2lev
} "REAL4 linear test state for the two-level regrid+prolongation test"



# --- Phase 2: edge-centered restriction test (interim I2) -------------------
#
# Edge-centered (centering rank 1: cell-centered along the edge's own
# direction, vertex-centered in the two transverse directions -- see
# StaggeredWaveToyX::fxstate/fystate/fzstate for the same {cvv}/{vcv}/{vvc}
# convention) counterparts of state8_2lev/state4_2lev above, one set of two
# groups per edge direction. Ridden along on the same testreal4_2lev.par
# regrid, these exercise CarpetX::Restrict's CCTK_REAL4 edge-centered path
# (schedule.cxx), which as of this
# writing goes through a local FAB-templated average-down kernel rather
# than amrex::average_down_edges (see src/testreal4_2lev.cxx's
# TestReal4_2Lev_EdgeCheck and the schedule.ccl comment above the relevant
# SYNC items).
#
# Interim: local FAB-templated edge average-down. Upstream goal: template
# amrex::average_down_edges over FAB (mirroring average_down_faces); drop
# this kernel when the ET's AMReX includes that.

CCTK_REAL8 state8_edgex TYPE=gf CENTERING={cvv} TAGS='dirichlet_values={0.0}'
{
  u8_edgex
} "REAL8 linear test state, edge-centered along x, for the restriction test"

CCTK_REAL4 state4_edgex TYPE=gf CENTERING={cvv} TAGS='dirichlet_values={0.0}'
{
  u4_edgex
} "REAL4 linear test state, edge-centered along x, for the restriction test"

CCTK_REAL8 state8_edgey TYPE=gf CENTERING={vcv} TAGS='dirichlet_values={0.0}'
{
  u8_edgey
} "REAL8 linear test state, edge-centered along y, for the restriction test"

CCTK_REAL4 state4_edgey TYPE=gf CENTERING={vcv} TAGS='dirichlet_values={0.0}'
{
  u4_edgey
} "REAL4 linear test state, edge-centered along y, for the restriction test"

CCTK_REAL8 state8_edgez TYPE=gf CENTERING={vvc} TAGS='dirichlet_values={0.0}'
{
  u8_edgez
} "REAL8 linear test state, edge-centered along z, for the restriction test"

CCTK_REAL4 state4_edgez TYPE=gf CENTERING={vvc} TAGS='dirichlet_values={0.0}'
{
  u4_edgez
} "REAL4 linear test state, edge-centered along z, for the restriction test"



# --- Phase 2: face-centered restriction test --------------------------------
#
# Face-centered (centering rank 2: vertex-centered along the face's own
# normal direction, cell-centered in the two transverse directions -- see
# StaggeredWaveToyX::fxstate/fystate/fzstate for the same convention, and
# note this is the complement of the edge centerings above: {vcc}/{cvc}/
# {ccv} rather than {cvv}/{vcv}/{vvc}) counterparts of
# state8_2lev/state4_2lev above, one set of two groups per face direction.
# Ridden along on the same testreal4_2lev.par regrid, these exercise
# CarpetX::Restrict's face-centered path (schedule.cxx) for float and
# double, which go through stock, unmodified amrex::average_down_faces (see
# src/testreal4_2lev.cxx's TestReal4_2Lev_FaceCheck and the schedule.ccl
# comment above the relevant SYNC items). TestReal2's face groups cover the
# CCTK_REAL2 side of the same path, which needs CarpetX's local,
# __half-clean average_down_faces_local kernel instead.

CCTK_REAL8 state8_facex TYPE=gf CENTERING={vcc} TAGS='dirichlet_values={0.0}'
{
  u8_facex
} "REAL8 linear test state, face-centered normal to x, for the restriction test"

CCTK_REAL4 state4_facex TYPE=gf CENTERING={vcc} TAGS='dirichlet_values={0.0}'
{
  u4_facex
} "REAL4 linear test state, face-centered normal to x, for the restriction test"

CCTK_REAL8 state8_facey TYPE=gf CENTERING={cvc} TAGS='dirichlet_values={0.0}'
{
  u8_facey
} "REAL8 linear test state, face-centered normal to y, for the restriction test"

CCTK_REAL4 state4_facey TYPE=gf CENTERING={cvc} TAGS='dirichlet_values={0.0}'
{
  u4_facey
} "REAL4 linear test state, face-centered normal to y, for the restriction test"

CCTK_REAL8 state8_facez TYPE=gf CENTERING={ccv} TAGS='dirichlet_values={0.0}'
{
  u8_facez
} "REAL8 linear test state, face-centered normal to z, for the restriction test"

CCTK_REAL4 state4_facez TYPE=gf CENTERING={ccv} TAGS='dirichlet_values={0.0}'
{
  u4_facez
} "REAL4 linear test state, face-centered normal to z, for the restriction test"



# --- Phase 2: physical boundary condition test ------------------------------
#
# Cell-centred, to also exercise the CC boundary condition code path (the
# two-level test above exercises VC). The dirichlet_values tag values below
# must match the constants hardcoded in src/testreal4_bc.cxx.

CCTK_REAL8 state8_bc TYPE=gf CENTERING={CCC} TAGS='dirichlet_values={7.0}'
{
  u8_bc
} "REAL8 test state for verifying dirichlet physical boundary conditions"

CCTK_REAL4 state4_bc TYPE=gf CENTERING={CCC} TAGS='dirichlet_values={4.25}'
{
  u4_bc
} "REAL4 test state for verifying dirichlet physical boundary conditions"



# --- Phase 2: ODESolvers evolution smoke test -------------------------------
#
# du/dt = -decay_rate * u, solved for both precisions independently (each
# (state, rhs) pair keeps its own precision throughout, per ODESolvers'
# mixed-precision statecomp_t support).

CCTK_REAL8 state8_evol TYPE=gf CENTERING={CCC} TAGS='rhs="TestReal4::rhs8_evol"'
{
  u8_evol
} "REAL8 exponential-decay ODE state (du/dt = -decay_rate u)"

CCTK_REAL8 rhs8_evol TYPE=gf CENTERING={CCC} TAGS='checkpoint="no"'
{
  r8_evol
} "RHS of state8_evol"

CCTK_REAL4 state4_evol TYPE=gf CENTERING={CCC} TAGS='rhs="TestReal4::rhs4_evol"'
{
  u4_evol
} "REAL4 exponential-decay ODE state (du/dt = -decay_rate u)"

CCTK_REAL4 rhs4_evol TYPE=gf CENTERING={CCC} TAGS='checkpoint="no"'
{
  r4_evol
} "RHS of state4_evol"



# =============================================================================
# Phase 4: grid scalar / grid array sized-real coverage
# =============================================================================
#
# CCTK_SCALAR/CCTK_ARRAY groups at the REAL8 and REAL4 sized-REAL precisions
# (TestReal2 adds the REAL2 pair), exercising CarpetX's AnyTypeVector-backed
# grid scalar/array storage (driver.hxx) end-to-end: allocation, poisoning,
# validity checking, checkpoint/recovery, and I/O output (TSV/openPMD/Silo),
# complementing the CCTK_GF coverage above. src/testreal4_scalar_array.cxx
# initializes each group with values that are exact binary fractions (so
# exactly representable at every precision, with no rounding tolerance
# needed) and re-verifies them bit-exactly after every iteration --
# including, in par/testreal4_io.par and par/testreal4_io_recover.par,
# across a checkpoint/recovery round trip.

CCTK_REAL8 scalar8 TYPE=scalar "REAL8 grid scalar test value"

CCTK_REAL4 scalar4 TYPE=scalar "REAL4 grid scalar test value"

CCTK_REAL8 array8 TYPE=array DIM=1 SIZE=16 DISTRIB=constant "REAL8 grid array test values"

CCTK_REAL4 array4 TYPE=array DIM=1 SIZE=16 DISTRIB=constant "REAL4 grid array test values"



# =============================================================================
# Phase 5: aliased-FUNCTION sized-REAL argument/return-type coverage
# =============================================================================
#
# Exercises the aliased-function grammar/binding-generation gap this
# workflow closes (repos/flesh/src/piraha/pegs/interface.peg's
# ret_type/arg_type rules, and CreateFunctionBindings.pl's ParseArgument
# allow-list): a sized CCTK_REAL4 return type together with mixed sized
# CCTK_REAL8 and CCTK_REAL4 argument types on the same aliased function.
# TestReal2 declares the same alias one precision wider (TestReal2_MixArgs,
# which also takes a CCTK_REAL2 argument) -- that is the variant that
# needs CCTK_REAL2 support, so it lives there; this REAL2-free one keeps
# the sized-REAL signature machinery covered on every platform.
# TestReal4 both PROVIDES and USES this function (mirroring, e.g.,
# Formaline's UniqueConfigID/UniqueBuildID/UniqueSimulationID, each of
# which is likewise PROVIDES-and-USES'd by its own declaring thorn), so no
# other thorn needs to be touched: src/testreal4_mixargs.cxx implements the
# provider (TestReal4_MixArgs_Impl), and src/testreal4_mixargs_check.cxx (a
# different translation unit) calls the alias and verifies the result.

CCTK_REAL4 FUNCTION TestReal4_MixArgs \
    (CCTK_REAL8 IN a, CCTK_REAL4 IN b)

PROVIDES FUNCTION TestReal4_MixArgs \
    WITH TestReal4_MixArgs_Impl \
    LANGUAGE C
USES FUNCTION TestReal4_MixArgs
